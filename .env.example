# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/booknook?retryWrites=true&w=majority

# Better Auth Secret (Minimum 32 characters, e.g. generated via `openssl rand -hex 32`)
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Better Auth Base URL
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ImgBB API Key (Required for the Add Book page)
# Used by the server-side upload proxy (src/app/api/upload/route.ts) so the key
# is never exposed to the browser. The key is read with process.env on the
# server only and is never given the NEXT_PUBLIC_ prefix.
IMGBB_API_KEY=your_imgbb_api_key_here
