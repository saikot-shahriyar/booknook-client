# Client Environment Variables

# Base URL of the BookNook Express backend API.
# The server listens on PORT=5000 in the booknook-server repository.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Base URL of this client app (local development).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth Base URL
BETTER_AUTH_URL=http://localhost:3000

# Better Auth Secret
# Minimum 32 characters — generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=<32+ character secret — e.g. openssl rand -hex 32>

# MongoDB Connection URI (database name: booknook)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/booknook

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=<your-google-client-id>

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ImgBB API Key (Required for the Add Book page)
# Used by the server-side upload proxy (src/app/api/upload/route.ts) so the key
# is never exposed to the browser. The key is read with process.env on the
# server only and is never given the NEXT_PUBLIC_ prefix.
IMGBB_API_KEY=<your-imgbb-api-key>
